# ---------------------------------------------------------------------------
# Divineesoft HRM
# Copy to .env.local. The app runs with NO values set — it falls back to the
# built-in demo company so you can deploy and click through immediately.
# ---------------------------------------------------------------------------

# AI assistant. Without this the assistant answers from on-device rules only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Database — leave blank to keep using demo data.
# Supabase → Project Settings → Database → Connection string
DATABASE_URL=
DIRECT_URL=

# Supabase project (file storage for documents and payslip PDFs)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hrm-documents

# Auth (needed once the database is connected)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# Company SMTP — the system sends as your own domain
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@divineesoft.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Divineesoft HR
SMTP_FROM_EMAIL=info@divineesoft.com
